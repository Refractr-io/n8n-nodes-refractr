{
	"name": "n8n-nodes-refractr",
	"version": "0.2.1",
	"description": "n8n node for Refractr: extract typed fields from invoices, delivery notes and other documents, with a confidence score per field to route doubtful results to review.",
	"license": "MIT",
	"homepage": "https://refractr.io",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"refractr",
		"document extraction",
		"invoice",
		"ocr",
		"idp",
		"accounts payable"
	],
	"author": {
		"name": "Sepp Beld",
		"email": "sepp@refractr.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Refractr-io/n8n-nodes-refractr.git"
	},
	"scripts": {
		"build": "n8n-node build && npm run bundle",
		"bundle": "esbuild dist/nodes/Refractr/Refractr.node.js --bundle --platform=node --target=node20 --format=cjs --external:n8n-workflow --legal-comments=eof --allow-overwrite --outfile=dist/nodes/Refractr/Refractr.node.js --log-level=warning",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test test/*.test.mjs"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/nodes/Refractr/Refractr.node.js.map",
		"!dist/nodes/Refractr/GenericFunctions.*",
		"!dist/nodes/Refractr/descriptions",
		"!dist/nodes/Refractr/files",
		"THIRD_PARTY_NOTICES.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/RefractrApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Refractr/Refractr.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/pako": "2.0.4",
		"esbuild": "0.25.10",
		"eslint": "9.32.0",
		"jpeg-js": "0.4.4",
		"pako": "2.1.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
